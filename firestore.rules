rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Global utility helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // LottoResult validation helper
    function isValidLottoResult(data) {
      return data.id is string && data.id.size() <= 128
        && data.gameName is string && data.gameName.size() <= 100
        && data.date is string && data.date.size() == 10
        && data.time is string && data.time.size() <= 50
        && data.edition is string && data.edition.size() <= 50
        && data.winningNumbers is list && data.winningNumbers.size() == 5
        && data.extraNumbers is list && data.extraNumbers.size() <= 10
        && data.machineNumbers is list && data.machineNumbers.size() <= 10;
    }

    // Lotto Results collection rules
    match /lotto_results/{id} {
      // Allow read access to anyone since it's a public lottery analyzer
      allow get, list: if true;

      // Allow write operations if the incoming data matches the LottoResult schema
      allow create: if isValidId(id) && isValidLottoResult(incoming()) && incoming().id == id;
      allow update: if isValidId(id) && isValidLottoResult(incoming()) && incoming().id == id;
      allow delete: if isValidId(id);
    }
  }
}
